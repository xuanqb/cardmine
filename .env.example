# AnkiWeb 凭据（仅注入 anki-connect-server 容器，不入库、不进日志）
ANKIWEB_USER=
ANKIWEB_PASS=

# 朋友 AnkiWeb 凭据（仅注入 anki-connect-friend 容器）
ANKIWEB_FRIEND_USER=
ANKIWEB_FRIEND_PASS=

# 宿主机数据目录（必须位于 NAS 本地存储，禁止 SMB/NFS）
APP_DATA_PATH=./data/app
ANKI_DATA_PATH=./data/anki
ANKI_FRIEND_DATA_PATH=./data/anki-friend

# 主应用对外端口
APP_PORT=8080

# 全量同步冲突保护：遇到冲突中止，避免误覆盖
ANKI_FAIL_ON_FULL_SYNC_CONFLICT=true
ANKI_FRIEND_FAIL_ON_FULL_SYNC_CONFLICT=true

# AnkiConnect 宿主机端口（无鉴权，仅限可信局域网，不要暴露到公网）
ANKI_PORT=8765
ANKI_FRIEND_PORT=8766
