# AnkiWeb 凭据（仅注入 anki-connect-server 容器，不入库、不进日志）
ANKIWEB_USER=
ANKIWEB_PASS=

# 宿主机数据目录（必须位于 NAS 本地存储，禁止 SMB/NFS）
APP_DATA_PATH=./data/app
ANKI_DATA_PATH=./data/anki

# 主应用对外端口
APP_PORT=8080

# 首次全量下载并校验完成后再改为 true
ANKI_FAIL_ON_FULL_SYNC_CONFLICT=false

# AnkiConnect 宿主机端口（无鉴权，仅限可信局域网，不要暴露到公网）
ANKI_PORT=8765
